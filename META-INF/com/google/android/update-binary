#!/sbin/sh

#################
# Initialization
#################

umask 022

# echo before loading util_functions
ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

abort_install() {
  ui_print "***************************************"
  ui_print " $1"
  ui_print "***************************************"
  exit 1
}

#########################
# Load util_functions.sh
#########################

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f ${OMFDIR:=/sdcard/OhMyFont}/twrp ] && ! ps | grep zygote | grep -qv grep && {
	TMPDIR=/dev/tmp
	rm -rf $TMPDIR
	mkdir -p $TMPDIR
	unzip $ZIPFILE -d $TMPDIR
	. $OMFDIR/twrp
	install_module
	exit 0
}

[ -f /data/adb/magisk/util_functions.sh ] && {
    . /data/adb/magisk/util_functions.sh
    [ $MAGISK_VER_CODE -lt 20400 ] && require_new_magisk
    install_module
    exit 0
}

[ -d /data/adb/ksu ] && abort_install "KernelSU detected. Install this ZIP from KernelSU Manager, not recovery."
[ -d /data/adb/ap ] && abort_install "APatch detected. Install this ZIP from APatch Manager, not recovery."

abort_install "Unsupported installer environment."
